schema_version: 1
policy:
  tier1_license_allowlist:
  - MIT
  - MIT-CMU
  - BSD-2-Clause
  - BSD-3-Clause
  - Apache-2.0
  - ISC
  - PSF-2.0
  conditional_tier1_licenses:
  - LGPL-2.1-only
  require_release_approval: true
  forbid_tier1_licenses:
  - GPL-2.0-only
  - GPL-2.0-or-later
  - GPL-3.0-only
  - GPL-3.0-or-later
  - AGPL-3.0-only
  - AGPL-3.0-or-later
  exact_pins_required: true
  transitive_license_audit_required: true
  wheel_hashes_required_for_release: true
  note: Package metadata labels are provisional until wheel contents, native libraries, transitive dependencies,
    hashes, and provenance are audited.
packages:
- name: mcp
  version: 1.28.0
  license: MIT
  tier: 1
  purpose: MCP server protocol and FastMCP integration
  verification: metadata-and-source-not-independently-audited
  release_approved: false
  provenance:
    intended_distribution: PyPI
    verified: false
    note: Distribution source, source repository, and artifact provenance have not been independently
      verified for this release.
  transitive_dependencies:
    status: pending-installed-environment-audit
    evidence_file: pipdeptree JSON and dependency-policy-report.json
  wheel_availability:
    status: pending-platform-build
    targets:
      windows_10_11_x64: unverified
      ubuntu_22_04_x64: unverified
      macos_14_arm64: unverified
    hashes: generated-per-target-in-wheelhouse-manifest.json
  python_compatibility:
    target: 3.11, 3.12, 3.13
    verified: false
    note: Must pass the CI matrix and actual target wheel build.
